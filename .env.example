# Ключ Anthropic — без него игра идёт на встроенном паке заданий
ANTHROPIC_API_KEY=sk-ant-...

# Необязательно
# PORT=7700
# PUBLIC_URL=https://balagan.example.com   # если адрес не определяется сам (редко)
# BALAGAN_ROUNDS=3                          # число раундов, последний всегда финал
# BALAGAN_WRITE=80                          # секунд на написание шуток
# BALAGAN_VOTE=20                           # секунд на голосование
# BALAGAN_MODEL=claude-opus-5-5             # модель для генерации заданий
